{
  "name": "probe",
  "description": "Day-1 probe: least-privilege profile for spikes K1/K2 (tools = @c64 + read; deny shell/write/web; c64_poke denied).",
  "model": "claude-sonnet-5.5",
  "tools": ["@c64", "read"],
  "includeMcpJson": true,
  "permissions": {
    "rules": [
      { "capability": "mcp", "match": ["c64/*"], "exclude": ["c64/c64_poke"], "effect": "allow" },
      { "capability": "mcp", "match": ["c64/c64_poke"], "effect": "deny" },
      { "capability": "fs_read", "match": ["**"], "effect": "allow" },
      { "capability": "shell", "match": ["*"], "effect": "deny" },
      { "capability": "fs_write", "match": ["**"], "effect": "deny" },
      { "capability": "web_fetch", "match": ["*"], "effect": "deny" },
      { "capability": "web_search", "match": ["*"], "effect": "deny" }
    ]
  },
  "hooks": [
    { "name": "checksum-gate", "trigger": "PreToolUse", "matcher": "@c64/apply_patch", "action": { "type": "command", "command": "node hook-gate.mjs" }, "timeout": 30 },
    { "name": "until-title", "trigger": "Stop", "action": { "type": "command", "command": "node hook-stop.mjs" }, "timeout": 30 }
  ]
}
