{
  "version": "v1",
  "hooks": [
    {
      "name": "prop-tests-on-save",
      "trigger": "PostFileSave",
      "matcher": "src/(basic|gate)/.*\\.ts$",
      "action": { "type": "command", "command": "node scripts/hooks/prop-tests-on-save.mjs" },
      "timeout": 120,
      "enabled": true
    }
  ]
}
